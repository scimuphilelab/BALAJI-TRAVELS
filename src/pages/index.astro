---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar';
import Hero from '../components/Hero';
import About from '../components/About';
import Fleet from '../components/Fleet';
import WhyChooseUs from '../components/WhyChooseUs';
import Testimonials from '../components/Testimonials';
import Contact from '../components/Contact';
import Footer from '../components/Footer';
---

<BaseLayout
  title="Balaji Travels | Vehicle Rental & Car Service in Bhubaneswar"
  description="Balaji Travels offers premium car rental in Bhubaneswar — outstation trips, airport transfers & luxury fleet. Professional drivers, 24/7 support."
  keywords="car rental Bhubaneswar, outstation cab Bhubaneswar, airport transfer Bhubaneswar, luxury car hire, Toyota Innova Crysta rental, Balaji Travels, cab booking Bhubaneswar, Puri trip Bhubaneswar"
>
  <Navbar client:load />
  <main id="main-content">
    <Hero client:load />
    <About />
    <Fleet client:load />
    <WhyChooseUs />
    <Testimonials />
    <Contact />
  </main>
  <Footer />
</BaseLayout>
